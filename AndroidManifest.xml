<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.tremu.app" android:versionCode="1" android:versionName="0.1">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="32" />
  <uses-feature android:glEsVersion="0x00030000" android:required="true" />
  <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />
  <!-- Mixed-reality background (the room behind the games), optional. -->
  <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="false" />
  <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <!-- Roms and Banner folders in shared storage (Tremu/), filled over USB. -->
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
  <!-- Two-headset play: inputs over UDP, game announcements by broadcast on the local network. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
  <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
  <queries>
    <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
    <intent><action android:name="org.khronos.openxr.OpenXRRuntimeService" /></intent>
    <intent><action android:name="org.khronos.openxr.OpenXRApiLayerService" /></intent>
    <!-- Other apps shown as carousel tiles (carousel.c known_apps): Android 11+ hides them otherwise. -->
    <package android:name="org.timecrisis.quest" />
    <package android:name="info.cemu.cemu" />
    <package android:name="org.vita3k.emulator" />
    <package android:name="com.armsx3" />
    <package android:name="com.xmjssvr.BowArrowEn" />
  </queries>
  <application android:label="Tremu" android:icon="@mipmap/ic_launcher" android:debuggable="true" android:allowBackup="false"
      android:extractNativeLibs="true" android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
    <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|quest3|quest3s" />
    <meta-data android:name="com.oculus.intent.category.VR" android:value="vr_only" />
    <activity android:name=".TremuActivity" android:exported="true" android:launchMode="singleTask"
        android:screenOrientation="landscape"
        android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density">
      <meta-data android:name="android.app.lib_name" android:value="tremu" />
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
        <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
        <category android:name="com.oculus.intent.category.VR" />
      </intent-filter>
    </activity>
    <!-- Reopens the app after an Xbox 360 game, whose emulator can only stop by ending the process. -->
    <activity android:name=".RestartActivity" android:process=":restart" android:exported="false"
        android:theme="@android:style/Theme.Translucent.NoTitleBar" />
  </application>
</manifest>
