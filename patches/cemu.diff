+++ b/src/android/app/src/main/java/info/cemu/cemu/nativeinterface/NativeXr.kt
@@ -0,0 +1,20 @@
+package info.cemu.cemu.nativeinterface
+
+import android.app.Activity
+import android.view.Surface
+
+object NativeXr {
+    const val SCREEN_WIDTH = 1920
+    const val SCREEN_HEIGHT = 1080
+
+    /** Set once the OpenXR session owns the display: the game draws into it, without any SurfaceView. */
+    var surface: Surface? = null
+        private set
+
+    fun startSession(activity: Activity) {
+        surface = start(activity)
+    }
+
+    @JvmStatic
+    private external fun start(activity: Activity): Surface?
+}
