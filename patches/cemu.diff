+// Updates and DLC sit beside the game: anywhere in its "wiiu" folder, else in its own folder.
+static void AddTitlesBeside(const fs::path& launchPath)
+{
+	fs::path root = launchPath.parent_path();
+	for (fs::path p = root; p.has_relative_path(); p = p.parent_path())
+	{
+		if (boost::iequals(_pathToUtf8(p.filename()), "wiiu"))
+		{
+			root = p;
+			break;
+		}
+	}
+	std::error_code ec;
+	fs::recursive_directory_iterator it(root, ec), end;
+	for (; !ec && it != end; it.increment(ec))
+	{
+		if (it.depth() >= 2)
+			it.disable_recursion_pending();
+		const std::string name = _pathToUtf8(it->path().filename());
+		if (it->path() != launchPath && (boost::iequals(name, "title.tmd") || boost::iends_with(name, ".wua")))
+			CafeTitleList::AddTitleFromPath(it->path());
+	}
+}
