@@ -255,6 +255,14 @@ void RenderCustomTile_Prio_TransMask_FlipXY_Clip(UINT16* pDestDraw, INT32 nWidth
 // Colour-depth independant image transfer
 
 extern UINT16* pTransDraw;
+
+// Tremu 3D view: layer of each pTransDraw pixel for drivers that report it. A driver calls
+// TremuLayersBegin(base) after clearing pTransDraw (base: layer of untouched pixels), then TremuLayersMark(n) after drawing each layer:
+// the pixels that layer changed take depth class n (1 background, 3 sprites, 4 foreground...).
+void TremuLayersBegin(UINT8 base);
+void TremuLayersMark(UINT8 layer);
+// The last frame's layers (nScreenWidth x nScreenHeight, top row first), or NULL.
+UINT8* TremuLayersGet(INT32* width, INT32* height);
 extern UINT8* pPrioDraw;
 
 void BurnTransferClear();
