diff --git a/src/burn/tiles_generic.cpp b/src/burn/tiles_generic.cpp
index ba540ff..de70e8b 100644
--- a/src/burn/tiles_generic.cpp
+++ b/src/burn/tiles_generic.cpp
@@ -139,6 +139,48 @@ void GenericTilesSetGfx(INT32 nNum, UINT8 *GfxBase, INT32 nDepth, INT32 nTileWid
 // Colour-depth independant image transfer
 
 UINT16* pTransDraw = NULL;
+
+static UINT8* pTremuLayers = NULL;
+static UINT16* pTremuSnapshot = NULL;
+static INT32 nTremuSize = 0;
+static UINT32 nTremuFrame = ~0U;
+
+void TremuLayersBegin(UINT8 base)
+{
+	INT32 size = nScreenWidth * nScreenHeight;
+	if (size <= 0 || pTransDraw == NULL) return;
+	if (size != nTremuSize) {
+		BurnFree(pTremuLayers);
+		BurnFree(pTremuSnapshot);
+		pTremuLayers = (UINT8*)BurnMalloc(size);
+		pTremuSnapshot = (UINT16*)BurnMalloc(size * sizeof(UINT16));
+		nTremuSize = (pTremuLayers && pTremuSnapshot) ? size : 0;
+		if (nTremuSize == 0) return;
+	}
+	memset(pTremuLayers, base, size);
+	memcpy(pTremuSnapshot, pTransDraw, size * sizeof(UINT16));
+	nTremuFrame = nCurrentFrame;
+}
+
+void TremuLayersMark(UINT8 layer)
+{
+	if (nTremuSize == 0 || nTremuFrame != nCurrentFrame) return;
+	for (INT32 i = 0; i < nTremuSize; i++) {
+		if (pTransDraw[i] != pTremuSnapshot[i]) {
+			pTremuLayers[i] = layer;
+			pTremuSnapshot[i] = pTransDraw[i];
+		}
+	}
+}
+
+UINT8* TremuLayersGet(INT32* width, INT32* height)
+{
+	// Only while the running driver reports layers (this frame or the one before).
+	if (nTremuSize == 0 || nTremuSize != nScreenWidth * nScreenHeight || nCurrentFrame - nTremuFrame > 1) return NULL;
+	*width = nScreenWidth;
+	*height = nScreenHeight;
+	return pTremuLayers;
+}
 UINT8 *pPrioDraw = NULL;
 
 static INT32 nTransWidth, nTransHeight;
