             break;
         }
         queued_bytes = monitor_num_used_bytes(d);
+#ifdef __ANDROID__
+        /* Tremu: a stalled audio output (headset asleep, stream write blocked)
+         * must not stop the APU: the guest kernel spins on APU progress and
+         * never reaches the game. Drop the queued audio and keep going. */
