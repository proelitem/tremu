+RETRO_API void retro_run(void) {
+  read_input();
+  if (frame_new.exchange(false)) {
+    int w, h;
+    {
+      std::lock_guard<std::mutex> lock(frame_mutex);
+      shown.swap(frame);
+      w = frame_w;
+      h = frame_h;
+    }
+    video_cb(shown.data(), w, h, size_t(w) * 4);
+  } else {
+    video_cb(nullptr, 0, 0, 0);
+  }
+}
