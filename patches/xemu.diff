+            qemu_clock_get_us(QEMU_CLOCK_REALTIME) - start_us > 250000) {
+            qemu_spin_lock(&d->monitor.fifo_lock);
+            fifo8_reset(&d->monitor.fifo);
+            qemu_spin_unlock(&d->monitor.fifo_lock);
+            break;
+        }
+#endif
