diff --git a/android/app/src/main/cpp/tremu_xemu.cpp b/android/app/src/main/cpp/tremu_xemu.cpp
new file mode 100644
--- /dev/null
+++ b/android/app/src/main/cpp/tremu_xemu.cpp
@@ -0,0 +1,281 @@
+// Tremu: xemu (original Xbox, from X1 BOX) as a libretro-shaped core, so Tremu drives it like its
+// other emulators (virtual screen in VR, Touch controllers as the Xbox pad, carousel and menu).
+//
+// - No SDLActivity here: SDL uses its offscreen video driver (EGL pbuffer), and its Android layer
+//   skips everything that needs its Java classes (see the Tremu notes in SDL_android.c).
+// - Video: ui/xemu.c calls tremu_frame_hook before each swap; the frame is read back and handed to the
+//   frontend as XRGB8888.
+// - Input: RetroPad port 0 feeds the keyboard controller (ui/xemu-input.c), bound to Xbox port 1.
+// - Audio: SDL's AAudio output (nothing goes through the frontend).
+// - Like Xenia here, one game per process: Tremu restarts itself when leaving the game.
+
+#include <GLES3/gl31.h>
+#include <android/log.h>
+#include <dirent.h>
+#include <dlfcn.h>
+#include <jni.h>
+#include <pthread.h>
+#include <sys/stat.h>
+
+#include <atomic>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "libretro.h"
+
+#define LOG(...) __android_log_print(ANDROID_LOG_INFO, "Tremu-xemu", __VA_ARGS__)
+
+extern "C" {
+// ui/xemu.c and ui/xemu-input.c
+extern void (*tremu_frame_hook)(int w, int h);
+extern int tremu_pad_active;
+extern uint32_t tremu_pad_buttons;
+extern int16_t tremu_pad_axis[6];
+extern int tremu_gun_visible;
+// xemu_android.cpp
+void tremu_xemu_set_files(const char* base, const char* mcpx, const char* flash, const char* hdd, const char* dvd);
+int SDL_main(int argc, char* argv[]);
+void SDL_SetMainReady(void);
+}
+
+namespace {
+
+constexpr int kMaxW = 1920, kMaxH = 1080;
+
+retro_environment_t environ_cb;
+retro_video_refresh_t video_cb;
+retro_input_poll_t input_poll_cb;
+retro_input_state_t input_state_cb;
+
+std::string files_dir;
+bool booted;
+
+std::mutex frame_mutex;
+std::vector<uint32_t> frame, shown, row;
+int frame_w, frame_h;
+std::atomic<bool> frame_new;
+
+void on_frame(int w, int h) {
+  if (w <= 0 || h <= 0 || w > kMaxW || h > kMaxH) return;
+  std::lock_guard<std::mutex> lock(frame_mutex);
+  frame.resize(size_t(w) * h);
+  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  glPixelStorei(GL_PACK_ALIGNMENT, 4);
+  glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, frame.data());
+  // GL starts at the bottom row, libretro at the top; RGBA bytes -> 0x00RRGGBB.
+  for (int y = 0; y < h / 2; y++) {
+    uint32_t* a = frame.data() + size_t(y) * w;
+    uint32_t* b = frame.data() + size_t(h - 1 - y) * w;
+    for (int x = 0; x < w; x++) std::swap(a[x], b[x]);
+  }
+  for (uint32_t& p : frame) p = ((p & 0xFF) << 16) | (p & 0xFF00) | ((p >> 16) & 0xFF);
+  frame_w = w;
+  frame_h = h;
+  frame_new = true;
+}
+
+void* xemu_thread(void*) {
+  SDL_SetMainReady();  // SDLActivity would have done this path
+  char name[] = "xemu";
+  char* argv[] = {name, nullptr};
+  int rc = SDL_main(1, argv);
+  LOG("xemu returned %d", rc);
+  return nullptr;
+}
+
+bool has_suffix(const std::string& s, const char* suffix) {
+  size_t n = strlen(suffix);
+  return s.size() >= n && !strcasecmp(s.c_str() + s.size() - n, suffix);
+}
+
+// The player's own console files: the 512-byte MCPX boot ROM, a BIOS image, the hard disk image.
+void find_console_files(const std::string& folder, std::string* mcpx, std::string* flash, std::string* hdd) {
+  DIR* d = opendir(folder.c_str());
+  if (!d) return;
+  for (dirent* e; (e = readdir(d));) {
+    std::string path = folder + "/" + e->d_name;
+    struct stat st;
+    if (stat(path.c_str(), &st) || !S_ISREG(st.st_mode)) continue;
+    if (has_suffix(path, ".qcow2")) {
+      if (hdd->empty()) *hdd = path;
+    } else if (has_suffix(path, ".bin") && st.st_size == 512) {
+      if (mcpx->empty()) *mcpx = path;
+    } else if (has_suffix(path, ".bin") && st.st_size >= 256 * 1024) {
+      if (flash->empty()) *flash = path;
+    }
+  }
+  closedir(d);
+}
+
+// RetroPad -> Xbox pad bits (controller_state_buttons_mask in ui/xemu-input.h).
+const struct { int retro; uint32_t mask; } kButtons[] = {
+    {RETRO_DEVICE_ID_JOYPAD_B, 1 << 0},      {RETRO_DEVICE_ID_JOYPAD_A, 1 << 1},
+    {RETRO_DEVICE_ID_JOYPAD_Y, 1 << 2},      {RETRO_DEVICE_ID_JOYPAD_X, 1 << 3},
+    {RETRO_DEVICE_ID_JOYPAD_LEFT, 1 << 4},   {RETRO_DEVICE_ID_JOYPAD_UP, 1 << 5},
+    {RETRO_DEVICE_ID_JOYPAD_RIGHT, 1 << 6},  {RETRO_DEVICE_ID_JOYPAD_DOWN, 1 << 7},
+    {RETRO_DEVICE_ID_JOYPAD_SELECT, 1 << 8}, {RETRO_DEVICE_ID_JOYPAD_START, 1 << 9},
+    {RETRO_DEVICE_ID_JOYPAD_L, 1 << 10},     {RETRO_DEVICE_ID_JOYPAD_R, 1 << 11},
+    {RETRO_DEVICE_ID_JOYPAD_L3, 1 << 12},    {RETRO_DEVICE_ID_JOYPAD_R3, 1 << 13},
+};
+
+int16_t clamp16(int v) { return int16_t(v < -32768 ? -32768 : v > 32767 ? 32767 : v); }
+
+void read_input() {
+  input_poll_cb();
+  uint32_t buttons = 0;
+  for (const auto& b : kButtons)
+    if (input_state_cb(0, RETRO_DEVICE_JOYPAD, 0, b.retro)) buttons |= b.mask;
+  auto axis = [](unsigned index, unsigned id) {
+    return int(input_state_cb(0, RETRO_DEVICE_ANALOG, index, id));
+  };
+  tremu_pad_buttons = buttons;
+  tremu_pad_axis[0] = input_state_cb(0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_L2) ? 32767 : 0;
+  tremu_pad_axis[1] = input_state_cb(0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_R2) ? 32767 : 0;
+  // libretro y grows downwards, the Xbox pad's upwards.
+  tremu_pad_axis[2] = clamp16(axis(RETRO_DEVICE_INDEX_ANALOG_LEFT, RETRO_DEVICE_ID_ANALOG_X));
+  tremu_pad_axis[3] = clamp16(-axis(RETRO_DEVICE_INDEX_ANALOG_LEFT, RETRO_DEVICE_ID_ANALOG_Y));
+  tremu_pad_axis[4] = clamp16(axis(RETRO_DEVICE_INDEX_ANALOG_RIGHT, RETRO_DEVICE_ID_ANALOG_X));
+  tremu_pad_axis[5] = clamp16(-axis(RETRO_DEVICE_INDEX_ANALOG_RIGHT, RETRO_DEVICE_ID_ANALOG_Y));
+  if (getenv("TREMU_XBOX_GUN")) {
+    // Light gun: aim in the left stick (0,0 at centre and when off-screen, y up), trigger on A.
+    // The gun's thumb pad, for the menus, comes from the Touch stick.
+    constexpr int kThumb = 16000;
+    int lx = tremu_pad_axis[2], ly = tremu_pad_axis[3];
+    if (lx < -kThumb) tremu_pad_buttons |= 1 << 4;
+    if (lx > kThumb) tremu_pad_buttons |= 1 << 6;
+    if (ly > kThumb) tremu_pad_buttons |= 1 << 5;
+    if (ly < -kThumb) tremu_pad_buttons |= 1 << 7;
+    bool off = input_state_cb(0, RETRO_DEVICE_LIGHTGUN, 0, RETRO_DEVICE_ID_LIGHTGUN_IS_OFFSCREEN);
+    tremu_gun_visible = !off;
+    tremu_pad_axis[2] = off ? 0 : clamp16(input_state_cb(0, RETRO_DEVICE_LIGHTGUN, 0, RETRO_DEVICE_ID_LIGHTGUN_SCREEN_X));
+    tremu_pad_axis[3] = off ? 0 : clamp16(-input_state_cb(0, RETRO_DEVICE_LIGHTGUN, 0, RETRO_DEVICE_ID_LIGHTGUN_SCREEN_Y));
+    if (input_state_cb(0, RETRO_DEVICE_LIGHTGUN, 0, RETRO_DEVICE_ID_LIGHTGUN_TRIGGER)) tremu_pad_buttons |= 1 << 0;
+    tremu_pad_axis[1] = 0;  // the Touch trigger is the gun's, not the pad's right trigger
+  }
+}
+
+}  // namespace
+
+// Tremu hands the Java VM and its activity before retro_init (dlopen'ed from native code: no
+// JNI_OnLoad). SDL needs the VM to attach its threads.
+extern "C" __attribute__((visibility("default"))) void tremu_set_android(JavaVM* vm, jobject activity) {
+  JNIEnv* env = nullptr;
+  bool attached = false;
+  if (vm->GetEnv((void**)&env, JNI_VERSION_1_6) != JNI_OK) {
+    vm->AttachCurrentThread(&env, nullptr);
+    attached = true;
+  }
+  jobject dir = env->CallObjectMethod(activity, env->GetMethodID(env->GetObjectClass(activity), "getFilesDir",
+                                                                 "()Ljava/io/File;"));
+  jstring path = (jstring)env->CallObjectMethod(dir, env->GetMethodID(env->GetObjectClass(dir), "getAbsolutePath",
+                                                                      "()Ljava/lang/String;"));
+  const char* chars = env->GetStringUTFChars(path, nullptr);
+  files_dir = chars;
+  env->ReleaseStringUTFChars(path, chars);
+  if (attached) vm->DetachCurrentThread();
+  void* sdl = dlopen("libSDL2.so", RTLD_NOW);
+  auto on_load = sdl ? reinterpret_cast<jint (*)(JavaVM*, void*)>(dlsym(sdl, "JNI_OnLoad")) : nullptr;
+  if (on_load) on_load(vm, nullptr);
+  else LOG("SDL's JNI_OnLoad not found");
+  LOG("files %s", files_dir.c_str());
+}
+
+extern "C" {
+
+RETRO_API unsigned retro_api_version(void) { return RETRO_API_VERSION; }
+RETRO_API void retro_set_environment(retro_environment_t cb) { environ_cb = cb; }
+RETRO_API void retro_set_video_refresh(retro_video_refresh_t cb) { video_cb = cb; }
+RETRO_API void retro_set_audio_sample(retro_audio_sample_t) {}
+RETRO_API void retro_set_audio_sample_batch(retro_audio_sample_batch_t) {}
+RETRO_API void retro_set_input_poll(retro_input_poll_t cb) { input_poll_cb = cb; }
+RETRO_API void retro_set_input_state(retro_input_state_t cb) { input_state_cb = cb; }
+RETRO_API void retro_init(void) {}
