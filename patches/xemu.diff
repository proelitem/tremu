+RETRO_API bool retro_load_game(const retro_game_info* game) {
+  if (!game || !game->path) return false;
+  if (booted) { LOG("xemu already ran a game in this process"); return false; }
+  enum retro_pixel_format format = RETRO_PIXEL_FORMAT_XRGB8888;
+  environ_cb(RETRO_ENVIRONMENT_SET_PIXEL_FORMAT, &format);
+
+  const char* system_dir = nullptr;
+  environ_cb(RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY, &system_dir);
+  std::string root = system_dir ? system_dir : "/storage/emulated/0/Tremu/bios";
+  std::string mcpx, flash, hdd;
+  find_console_files(root + "/xbox", &mcpx, &flash, &hdd);
+  find_console_files(root + "/../Xbox/system", &mcpx, &flash, &hdd);
+  if (mcpx.empty() || flash.empty() || hdd.empty()) {
+    LOG("console files missing: mcpx '%s' bios '%s' disk '%s'", mcpx.c_str(), flash.c_str(), hdd.c_str());
+    return false;
+  }
+  if (files_dir.empty() && getenv("TREMU_FILES_DIR")) files_dir = getenv("TREMU_FILES_DIR");  // test harness
+  std::string base = files_dir + "/xemu";
+  mkdir(base.c_str(), 0700);
+  setenv("SDL_VIDEODRIVER", "offscreen", 1);
+  setenv("SDL_JOYSTICK_HIDAPI", "0", 1);
+  setenv("TREMU_XEMU_BASE", base.c_str(), 1);
+  setenv("XEMU_RENDERER", getenv("TREMU_RENDERER") ? getenv("TREMU_RENDERER") : "vulkan", 1);
+  LOG("boot %s, mcpx %s, bios %s, disk %s", game->path, mcpx.c_str(), flash.c_str(), hdd.c_str());
+  tremu_xemu_set_files(base.c_str(), mcpx.c_str(), flash.c_str(), hdd.c_str(), game->path);
+  tremu_frame_hook = on_frame;
+  tremu_pad_active = 1;
+  pthread_t thread;
+  pthread_attr_t attr;
+  pthread_attr_init(&attr);
+  pthread_attr_setstacksize(&attr, 8 * 1024 * 1024);
+  if (pthread_create(&thread, &attr, xemu_thread, nullptr)) return false;
+  booted = true;
+  return true;
+}
