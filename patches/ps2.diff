+
+	static const uint8_t guncon2_config_desc[] = {
+		0x09, // Length
+		0x02, // Type (Config)
+		0x19, 0x00, // Total size
+		0x01, // # interfaces
+		0x01, // Configuration #
+		0x00, // index of string descriptor
+		0x80, // Attributes (bus powered)
+		0x19, // Max power in mA
+
+		// Interface
+		0x09, // Length
+		0x04, // Type (Interface)
+		0x00, // Interface #
+		0x00, // Alternative #
+		0x01, // # endpoints
+		0xff, // Class
+		0x6a, // Subclass
