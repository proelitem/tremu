+
+		// Endpoint
+		0x07, // Length
+		0x05, // Type (Endpoint)
+		0x81, // Address
+		0x03, // Attributes (interrupt transfers)
+		0x08, 0x00, // Max packet size
+		0x08, // Polling interval (frame counts)
+	};
+
+	/* "SCES-50300" and "SCES_503.00" both name the same disc: compare letters and digits only. */
+	static bool same_serial(const char* a, const char* b)
+	{
+		for (;;)
+		{
+			while (*a && !isalnum((unsigned char)*a))
+				a++;
+			while (*b && !isalnum((unsigned char)*b))
+				b++;
+			if (!*a || !*b)
+				return !*a && !*b;
+			if (toupper((unsigned char)*a++) != toupper((unsigned char)*b++))
+				return false;
+		}
+	}
+
+	void GunCon2State::AutoConfigure()
+	{
+		for (const GameConfig& gc : s_game_config)
+		{
+			if (!same_serial(DiscSerial, gc.serial))
+				continue;
+			log_cb(RETRO_LOG_INFO, "GunCon2: settings for %s: scale %.4fx%.4f, centre %ux%u, screen %ux%u\n",
+				gc.serial, gc.scale_x / 100.0f, gc.scale_y / 100.0f, gc.center_x, gc.center_y, gc.screen_width,
+				gc.screen_height);
+			scale_x = gc.scale_x / 100.0f;
+			scale_y = gc.scale_y / 100.0f;
+			center_x = static_cast<float>(gc.center_x);
+			center_y = static_cast<float>(gc.center_y);
+			screen_width = gc.screen_width;
+			screen_height = gc.screen_height;
+			return;
+		}
+		log_cb(RETRO_LOG_WARN, "GunCon2: no settings for disc '%s', using defaults\n", DiscSerial);
+	}
+
+	void GunCon2State::CalculatePosition(s16* pos_x, s16* pos_y) const
+	{
+		if (!on_screen)
+		{
+			*pos_x = 0;
+			*pos_y = 0;
+			return;
+		}
+		/* Scale to the gun's coordinate system, around the game's centre. */
+		float fx = (pointer_x * static_cast<float>(screen_width)) - static_cast<float>(screen_width / 2u);
+		float fy = (pointer_y * static_cast<float>(screen_height)) - static_cast<float>(screen_height / 2u);
+		fx *= scale_x;
+		fy *= scale_y;
+		s32 x = static_cast<s32>(std::lround(fx + center_x));
+		s32 y = static_cast<s32>(std::lround(fy + center_y));
+		if (param_mode & GUNCON2_FLAG_PROGRESSIVE)
+		{
+			x -= param_x / 2;
+			y -= param_y / 2;
+		}
+		else
+		{
+			x -= param_x;
+			y -= param_y;
+		}
+		/* 0,0 means off screen. */
+		*pos_x = static_cast<s16>(x < 1 ? 1 : x);
+		*pos_y = static_cast<s16>(y < 1 ? 1 : y);
+	}
+
+	static void guncon2_handle_control(
+		USBDevice* dev, USBPacket* p, int request, int value, int index, int length, uint8_t* data)
+	{
+		GunCon2State* const us = USB_CONTAINER_OF(dev, GunCon2State, dev);
+
+		/* The game is loaded by the first control request: its serial picks the scales. */
+		if (!us->auto_config_done)
+		{
+			us->AutoConfigure();
+			us->auto_config_done = true;
+		}
+
+		if (usb_desc_handle_control(dev, p, request, value, index, length, data) >= 0)
+			return;
+
+		if (request == (ClassInterfaceOutRequest | 0x09))
+		{
+			us->param_x = static_cast<s16>(static_cast<u16>(data[0]) | (static_cast<u16>(data[1]) << 8));
+			us->param_y = static_cast<s16>(static_cast<u16>(data[2]) | (static_cast<u16>(data[3]) << 8));
+			us->param_mode = static_cast<u16>(data[4]) | (static_cast<u16>(data[5]) << 8);
+			return;
+		}
+
+		p->status = USB_RET_STALL;
+	}
+
+	static void guncon2_handle_data(USBDevice* dev, USBPacket* p)
+	{
+		GunCon2State* const us = USB_CONTAINER_OF(dev, GunCon2State, dev);
+
+		if (p->pid == USB_TOKEN_IN && p->ep->nr == 1)
+		{
+			s16 pos_x, pos_y;
+			us->CalculatePosition(&pos_x, &pos_y);
+
+			/* Time Crisis calibrates by showing one black frame and waiting for (0, 0): after
+			 * a recalibration request, hold the trigger and the position a few reports, then
+			 * report (0, 0). */
+			if ((us->button_state & (1u << BID_RECALIBRATE)) && us->calibration_timer == 0)
+			{
+				us->calibration_timer = GUNCON2_CALIBRATION_DELAY;
+				us->calibration_pos_x = pos_x;
+				us->calibration_pos_y = pos_y;
+			}
+
+			/* Buttons are active low. */
+			GunCon2Out out;
+			out.buttons = static_cast<u16>(~us->button_state) | (us->param_mode & GUNCON2_FLAG_PROGRESSIVE);
+			out.pos_x = pos_x;
+			out.pos_y = pos_y;
+
+			if (us->calibration_timer > 0)
+			{
+				out.buttons &= ~(1u << BID_TRIGGER);
+				out.pos_x = us->calibration_pos_x;
+				out.pos_y = us->calibration_pos_y;
+				us->calibration_timer--;
+				if (us->calibration_timer < GUNCON2_CALIBRATION_REPORT_DELAY)
+				{
+					out.pos_x = 0;
+					out.pos_y = 0;
+				}
+			}
+			else if (us->button_state & (1u << BID_SHOOT_OFFSCREEN))
+			{
+				/* Off-screen shot (reload in most games): trigger at (0, 0). */
+				out.buttons &= ~(1u << BID_TRIGGER);
+				out.pos_x = 0;
+				out.pos_y = 0;
+			}
+
+			usb_packet_copy(p, &out, sizeof(out));
+			return;
+		}
+
+		p->status = USB_RET_STALL;
+	}
+
+	static void guncon2_unrealize(USBDevice* dev)
+	{
+		GunCon2State* us = USB_CONTAINER_OF(dev, GunCon2State, dev);
+		delete us;
+	}
+
+	USBDevice* create(u32 port)
+	{
+		GunCon2State* s = new GunCon2State(port);
+		s->desc.full = &s->desc_dev;
+		s->desc.str = desc_strings;
+
+		if (usb_desc_parse_dev(guncon2_dev_desc, sizeof(guncon2_dev_desc), s->desc, s->desc_dev) < 0 ||
+			usb_desc_parse_config(guncon2_config_desc, sizeof(guncon2_config_desc), s->desc_dev) < 0)
+		{
+			guncon2_unrealize(&s->dev);
+			return nullptr;
+		}
+
+		s->dev.speed = USB_SPEED_FULL;
+		s->dev.klass.handle_attach = usb_desc_attach;
+		s->dev.klass.handle_control = guncon2_handle_control;
+		s->dev.klass.handle_data = guncon2_handle_data;
+		s->dev.klass.unrealize = guncon2_unrealize;
+		s->dev.klass.usb_desc = &s->desc;
+		s->dev.klass.product_desc = s->desc.str[1];
+
+		usb_desc_init(&s->dev);
+		usb_ep_init(&s->dev);
+		log_cb(RETRO_LOG_INFO, "GunCon2 on USB port %u\n", port + 1);
+		return &s->dev;
+	}
+
+	void update(USBDevice* dev, retro_input_state_t input_cb, unsigned port)
+	{
+		GunCon2State* s = USB_CONTAINER_OF(dev, GunCon2State, dev);
+		if (!input_cb)
+			return;
+		/* The scales follow the disc (also after loading a state, which keeps no scales). */
+		if (!s->auto_config_done && DiscSerial[0])
+		{
+			s->AutoConfigure();
+			s->auto_config_done = true;
+		}
+
+		/* Position: -0x7fff..0x7fff over the frontend's view of the game, to 0..1. */
+		const int x = input_cb(port, RETRO_DEVICE_LIGHTGUN, 0, RETRO_DEVICE_ID_LIGHTGUN_SCREEN_X);
+		const int y = input_cb(port, RETRO_DEVICE_LIGHTGUN, 0, RETRO_DEVICE_ID_LIGHTGUN_SCREEN_Y);
+		s->on_screen = !input_cb(port, RETRO_DEVICE_LIGHTGUN, 0, RETRO_DEVICE_ID_LIGHTGUN_IS_OFFSCREEN);
+		s->pointer_x = (x + 0x7fff) / 65534.0f;
+		s->pointer_y = (y + 0x7fff) / 65534.0f;
+
+		static const struct { unsigned id; u32 bid; } binds[] = {
+			{RETRO_DEVICE_ID_LIGHTGUN_TRIGGER, BID_TRIGGER},
+			{RETRO_DEVICE_ID_LIGHTGUN_AUX_A, BID_A},
+			{RETRO_DEVICE_ID_LIGHTGUN_AUX_B, BID_B},
+			{RETRO_DEVICE_ID_LIGHTGUN_AUX_C, BID_C},
+			{RETRO_DEVICE_ID_LIGHTGUN_START, BID_START},
+			{RETRO_DEVICE_ID_LIGHTGUN_SELECT, BID_SELECT},
+			{RETRO_DEVICE_ID_LIGHTGUN_DPAD_UP, BID_DPAD_UP},
+			{RETRO_DEVICE_ID_LIGHTGUN_DPAD_DOWN, BID_DPAD_DOWN},
+			{RETRO_DEVICE_ID_LIGHTGUN_DPAD_LEFT, BID_DPAD_LEFT},
+			{RETRO_DEVICE_ID_LIGHTGUN_DPAD_RIGHT, BID_DPAD_RIGHT},
+			/* Reload: a shot that also reports (0, 0) a moment later, which is what Time Crisis
+			 * calibration waits for and what reloads in the other games. */
+			{RETRO_DEVICE_ID_LIGHTGUN_RELOAD, BID_RECALIBRATE},
+		};
+		u32 buttons = 0;
+		for (const auto& b : binds)
+			if (input_cb(port, RETRO_DEVICE_LIGHTGUN, 0, b.id))
+				buttons |= 1u << b.bid;
+		s->button_state = buttons;
+	}
+
+	void freeze(USBDevice* dev, UsbState& st)
+	{
+		GunCon2State* s = USB_CONTAINER_OF(dev, GunCon2State, dev);
+		st.Do(&s->param_x);
+		st.Do(&s->param_y);
+		st.Do(&s->param_mode);
+		st.Do(&s->calibration_timer);
+		st.Do(&s->calibration_pos_x);
+		st.Do(&s->calibration_pos_y);
+	}
+} // namespace usb_guncon2
