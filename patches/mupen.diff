+bool Context::StereoOn = false;
+f32 Context::StereoSeparation = 0.0f;
+
+extern "C" void wfg_stereo_update(int _on, float _separation)
+{
+	Context::StereoOn = _on != 0;
+	Context::StereoSeparation = _separation;
+}
+
+namespace {
+	struct StereoTwin { ObjectHandle main, twin; };
+	std::vector<StereoTwin> stereoTwins;
+	ObjectHandle stereoDrawFbo, stereoDrawTwin;
+	/* The distance where the eyes agree (the screen plane): a low percentile of the vertices' w,
+	 * in the game's own units, found per frame in a log2 histogram and eased. */
+	const u32 stereoBins = 32;
+	u32 stereoHistogram[stereoBins];
+	f32 stereoLogConvergence = -1.0f, stereoConvergence = 0.0f;
+	std::vector<f32> stereoSavedX;
+
+	void stereoTrack(ObjectHandle _fbo)
+	{
+		stereoDrawFbo = _fbo;
+		stereoDrawTwin = ObjectHandle::null;
+		for (const StereoTwin & t : stereoTwins)
+			if (t.main == _fbo)
+				stereoDrawTwin = t.twin;
+	}
+
+	bool stereoFlat(const SPVertex & _v)
+	{
+		/* Screen-space vertices, and orthographic ones (2D drawn as triangles). */
+		return (_v.modify & MODIFY_XY) != 0 || std::fabs(_v.w - 1.0f) < 0.001f || _v.w <= 0.0f;
+	}
+
+	void stereoShift(SPVertex * _v, u32 _count, f32 _eye)
+	{
+		for (u32 i = 0; i < _count; ++i) {
+			if (stereoFlat(_v[i]))
+				continue;
+			/* Nothing comes nearer than half the plane's distance, to stay comfortable. */
+			const f32 near = std::min(stereoConvergence, 2.0f * _v[i].w);
+			_v[i].x += _eye * Context::StereoSeparation * (_v[i].w - near);
+		}
+	}
+}
+
+void Context::stereoAddTwin(ObjectHandle _main, ObjectHandle _twin)
+{
+	stereoTwins.push_back({ _main, _twin });
+	if (_main == stereoDrawFbo)
+		stereoDrawTwin = _twin;
+}
+
+void Context::stereoRemoveTwin(ObjectHandle _main)
+{
+	for (size_t i = 0; i < stereoTwins.size(); ++i)
+		if (stereoTwins[i].main == _main) {
+			stereoTwins.erase(stereoTwins.begin() + i);
+			break;
+		}
+	if (_main == stereoDrawFbo)
+		stereoDrawTwin = ObjectHandle::null;
+}
+
+void Context::stereoEndFrame()
+{
+	u32 total = 0;
+	for (u32 i = 0; i < stereoBins; ++i)
+		total += stereoHistogram[i];
+	if (total == 0)
+		return;
+	u32 seen = 0, bin = 0;
+	while (bin < stereoBins - 1 && (seen += stereoHistogram[bin]) * 5 < total)
+		++bin;
+	memset(stereoHistogram, 0, sizeof stereoHistogram);
+	const f32 target = static_cast<f32>(bin) + 0.5f;
+	stereoLogConvergence = stereoLogConvergence < 0.0f ? target : stereoLogConvergence + (target - stereoLogConvergence) * 0.05f;
+	stereoConvergence = std::pow(2.0f, stereoLogConvergence);
+}
