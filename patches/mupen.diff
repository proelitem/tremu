+		m_impl->drawTriangles(_params);
+		return;
+	}
+	SPVertex * v = _params.vertices;
+	const u32 n = _params.verticesCount;
+	stereoSavedX.resize(n);
+	for (u32 i = 0; i < n; ++i) {
+		stereoSavedX[i] = v[i].x;
+		if (!stereoFlat(v[i])) {
+			int exponent = 0;
+			std::frexp(v[i].w, &exponent);
+			++stereoHistogram[exponent < 0 ? 0 : exponent >= static_cast<int>(stereoBins) ? stereoBins - 1 : exponent];
+		}
+	}
+	stereoShift(v, n, -1.0f);
 	m_impl->drawTriangles(_params);
+	for (u32 i = 0; i < n; ++i)
+		v[i].x = stereoSavedX[i];
+	stereoShift(v, n, 1.0f);
+	m_impl->bindFramebuffer(bufferTarget::DRAW_FRAMEBUFFER, stereoDrawTwin);
+	m_impl->drawTriangles(_params);
+	m_impl->bindFramebuffer(bufferTarget::DRAW_FRAMEBUFFER, stereoDrawFbo);
+	for (u32 i = 0; i < n; ++i)
+		v[i].x = stereoSavedX[i];
