 void Context::drawRects(const DrawRectParameters & _params)
 {
 	m_impl->drawRects(_params);
+	if (StereoOn && stereoDrawTwin.isNotNull()) {
+		m_impl->bindFramebuffer(bufferTarget::DRAW_FRAMEBUFFER, stereoDrawTwin);
+		m_impl->drawRects(_params);
+		m_impl->bindFramebuffer(bufferTarget::DRAW_FRAMEBUFFER, stereoDrawFbo);
+	}
 }
 
 void Context::drawLine(f32 _width, SPVertex * _vertices)
 {
+	if (!StereoOn || !stereoDrawTwin.isNotNull()) {
+		m_impl->drawLine(_width, _vertices);
+		return;
+	}
+	const f32 x0 = _vertices[0].x, x1 = _vertices[1].x;
+	stereoShift(_vertices, 2, -1.0f);
+	m_impl->drawLine(_width, _vertices);
+	_vertices[0].x = x0;
+	_vertices[1].x = x1;
+	stereoShift(_vertices, 2, 1.0f);
+	m_impl->bindFramebuffer(bufferTarget::DRAW_FRAMEBUFFER, stereoDrawTwin);
 	m_impl->drawLine(_width, _vertices);
+	m_impl->bindFramebuffer(bufferTarget::DRAW_FRAMEBUFFER, stereoDrawFbo);
+	_vertices[0].x = x0;
+	_vertices[1].x = x1;
 }
 
