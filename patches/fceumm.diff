+/* Same choice as CopySprites, made before it overwrites the background pixels:
+ * bit 6 of a background pixel marks colour 0 (transparent). */
+static void TremuRecordLayers(const uint8_t *target) {
+	uint8_t *L = tremu_layers + (scanline << 8);
+	int x;
+	for (x = 0; x < 256; x++)
+		L[x] = (target[x] & 0x40) ? 0 : 1;
+	if (!SpriteON || !spork || (rendis & 1))
+		return;
+	for (x = ((PPU[1] & 4) ^ 4) << 1; x < 256; x++) {
+		uint8_t s = sprlinebuf[x];
+		if (s & 0x80)
+			continue;	/* no sprite pixel */
+		if (!(s & 0x40))
+			L[x] = 3;
+		else if (target[x] & 0x40)
+			L[x] = 2;
+	}
+}
